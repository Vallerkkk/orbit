<Window x:Class="Orbita.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Órbita"
        Width="1280"
        Height="820"
        MinWidth="860"
        MinHeight="560"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Icon="Assets/icon.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Grid x:Name="MainGrid">
        <wv2:WebView2 x:Name="Browser" Visibility="Collapsed" AllowExternalDrop="True" />

        <Grid x:Name="LoadingLayer">
            <Grid.Background>
                <RadialGradientBrush Center="0.5,0.44" GradientOrigin="0.5,0.44" RadiusX="1.05" RadiusY="1.05">
                    <GradientStop Color="#1A102C" Offset="0" />
                    <GradientStop Color="#0D0A15" Offset="0.48" />
                    <GradientStop Color="#09090E" Offset="1" />
                </RadialGradientBrush>
            </Grid.Background>

            <StackPanel Width="430"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0,-18,0,0">
                <Grid Width="330" Height="292" HorizontalAlignment="Center">
                    <Ellipse Width="228" Height="228" Opacity="0.65">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#8B5CF6" Offset="0" />
                                <GradientStop Color="#3B1E70" Offset="0.52" />
                                <GradientStop Color="#001A102C" Offset="1" />
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Ellipse Width="318" Height="144"
                             Stroke="#6B5A8C"
                             StrokeThickness="1"
                             Opacity="0.65"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="-27" />
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <Ellipse Width="344" Height="164"
                             Stroke="#44385C"
                             StrokeThickness="1"
                             Opacity="0.55"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="40" />
                        </Ellipse.RenderTransform>
                    </Ellipse>

                    <Canvas Width="330" Height="292" IsHitTestVisible="False">
                        <Ellipse Canvas.Left="41" Canvas.Top="90" Width="7" Height="7" Fill="#D4C3FF">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#9B64FF" BlurRadius="16" ShadowDepth="0" Opacity="0.8" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Canvas.Left="274" Canvas.Top="150" Width="5" Height="5" Fill="#CDB3FF">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#A882FF" BlurRadius="12" ShadowDepth="0" Opacity="0.7" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse Canvas.Left="44" Canvas.Top="214" Width="3" Height="3" Fill="#CDB3FF" Opacity="0.8" />
                        <Ellipse Canvas.Left="288" Canvas.Top="76" Width="3" Height="3" Fill="#CDB3FF" Opacity="0.6" />
                    </Canvas>

                    <Image Source="Assets/loader-icon.png"
                           Width="190"
                           Height="162"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Effect>
                            <DropShadowEffect Color="#7438ED" BlurRadius="36" ShadowDepth="0" Opacity="0.42" />
                        </Image.Effect>
                    </Image>
                </Grid>

                <Image Source="Assets/wordmark.png"
                       Width="212"
                       Height="56"
                       Margin="0,-14,0,0"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <TextBlock x:Name="LoadingText"
                           Text="PREPARANDO SEU UNIVERSO…"
                           Margin="0,24,0,0"
                           FontSize="10.5"
                           FontWeight="SemiBold"
                           Foreground="#A59BB6"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <Grid Width="190" Height="2" Margin="0,14,0,0" ClipToBounds="True" HorizontalAlignment="Center">
                    <Border Background="#16FFFFFF" CornerRadius="1" />
                    <Border x:Name="LoadingPulse"
                            Width="62"
                            HorizontalAlignment="Left"
                            CornerRadius="1"
                            Opacity="0.95">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Color="#008B5CF6" Offset="0" />
                                <GradientStop Color="#8B5CF6" Offset="0.5" />
                                <GradientStop Color="#D4BAFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="LoadingPulseTransform" X="-90" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>

                <TextBlock x:Name="LoadingHint"
                           Text="A primeira abertura pode levar alguns segundos."
                           Margin="0,16,0,0"
                           FontSize="10.5"
                           Foreground="#6E657C"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Text="CONEXÕES EM MOVIMENTO"
                       FontSize="9"
                       Foreground="#6E657C"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Margin="26,0,0,26" />

            <TextBlock Text="Valler × Kalil"
                       FontSize="9.5"
                       Foreground="#6E657C"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,26,26" />
        </Grid>

        <Grid x:Name="StatusLayer" Background="{StaticResource BgBrush}" Visibility="Collapsed">
            <StackPanel Width="520"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Border Width="58"
                        Height="58"
                        CornerRadius="29"
                        Background="#171A22"
                        BorderBrush="#2B303B"
                        BorderThickness="1"
                        HorizontalAlignment="Center">
                    <TextBlock x:Name="StatusGlyph"
                               Text="!"
                               FontSize="25"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <TextBlock x:Name="StatusTitle"
                           Text="Não foi possível abrir o Órbita"
                           Margin="0,20,0,0"
                           FontSize="22"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <TextBlock x:Name="StatusMessage"
                           Text="Verifique sua conexão com a internet e tente novamente."
                           Margin="0,10,0,0"
                           FontSize="13.5"
                           LineHeight="20"
                           Foreground="{StaticResource MutedBrush}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,26,0,0">
                    <Button x:Name="StatusPrimaryButton"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,0,8,0"
                            Click="OnStatusPrimaryClick" />
                    <Button x:Name="StatusSecondaryButton"
                            Style="{StaticResource BaseButton}"
                            Click="OnStatusSecondaryClick" />
                </StackPanel>

                <Button x:Name="StatusSiteButton"
                        Content="Abrir no navegador"
                        Style="{StaticResource GhostButton}"
                        Margin="0,14,0,0"
                        HorizontalAlignment="Center"
                        Click="OnStatusSiteClick" />
            </StackPanel>

            <TextBlock Text="2.0.0"
                       FontSize="11"
                       Foreground="#565C68"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,18,14" />
        </Grid>
    </Grid>
</Window>

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=

# Web Push opcional: preencher apenas no servidor; nunca no frontend.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PUSH_TRANSPORT_KEY=

# Opcional: somente servidor. Confirmar plano Gratuito e desligar gravação/transcrição no provedor.
VIDEOCHAMADA_API_KEY=
VIDEOCHAMADA_FREE_PLAN_CONFIRMED=false

# Opcionais e desligados quando vazios: dados públicos de projeto, nunca tokens de gestão.
SENTRY_PUBLIC_DSN=
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=

# Diagnóstico Gemini: somente servidor. Manter desligado até verificar o projeto no AI Studio.
# Limites de tokens não impedem cobrança em um projeto pago.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_DIAGNOSTICS_ENABLED=false

# Lula — IA via Flatkey (somente no servidor/Render)
FLATKEY_API_KEY=
FLATKEY_MODEL=MiniMax-H3

# Transcrição no PC por Groq Whisper
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo

# LulaDroid — NVIDIA NIM Nemotron 3 Ultra (segredo somente no backend/Render)
NVIDIA_API_KEY=
NVIDIA_NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
GIPHY_API_KEY=

# YouTube no Órbita (somente backend/Render — nunca vão para o cliente)
YOUTUBE_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Chave para cifrar o refresh token no servidor (>=16 caracteres aleatórios, ex.: openssl rand -base64 32)
YOUTUBE_TOKEN_KEY=
# URL pública usada no redirect do OAuth (ex.: https://orbita.onrender.com)
PUBLIC_BASE_URL=

# Astro — transcrição e respostas nas calls (segredo apenas no servidor)
GROQ_API_KEY=
ASTRO_STT_MODEL=whisper-large-v3-turbo
ASTRO_LLM_MODEL=openai/gpt-oss-20b
